# ============================================================
# Supabase Zugangsdaten
# ============================================================
# 1. Diese Datei kopieren und als ".env" speichern
# 2. Die Werte aus dem Supabase-Dashboard eintragen
#    (Supabase → Project Settings → API)
# 3. Die .env Datei NIEMALS in Git committen!
#    (.gitignore enthält bereits ".env")
#
# WICHTIG: In Vite müssen alle Browser-Variablen mit VITE_ beginnen.
# ============================================================

VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein_anon_key_hier
